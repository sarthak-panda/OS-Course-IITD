diff --git a/hellos/hellos.c b/hellos/hellos.c
new file mode 100644
index 000000000..86dcce087
--- /dev/null
+++ b/hellos/hellos.c
@@ -0,0 +1,221 @@
+#include <linux/kernel.h>
+#include <linux/uaccess.h>
+#include <linux/sched/gang.h>
+#include <linux/syscalls.h>
+#include <linux/sched.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/slab.h>
+#include <linux/rcupdate.h>
+#include <linux/errno.h>
+#include <linux/cpumask.h>
+#include <uapi/linux/sched/types.h>
+struct gang_pid {
+    int pid;
+    struct list_head list;
+};
+struct gang_node {
+    int gangid;
+    int num_threads;
+    struct list_head pid_list;
+    struct list_head list;
+};
+static LIST_HEAD(gang_list);
+static DEFINE_SPINLOCK(gang_list_lock);
+static int __exit_gang(int pid);
+static void exec_timer_callback(struct timer_list *t)
+{
+    struct gang_thread *gthd = from_timer(gthd, t, timer);
+    __exit_gang(gthd->pid);
+}
+SYSCALL_DEFINE0(hellos) {
+	printk("I am linux modified[gang scheduling]....\n");
+	return 0;
+}
+SYSCALL_DEFINE3(register_gang, int, pid, int, gangid, int, exec_time) {
+	struct task_struct *p;
+    struct gang_thread *gthd;
+	struct sched_param param = { .sched_priority = 0 };
+	struct gang_node *gnode;
+    struct gang_pid *gpid;
+	bool new_gang = false;
+	int ret = 0;
+    unsigned long flags;
+    int cpu;
+	if (gangid < 0 || exec_time <= 0) return -EINVAL;
+	spin_lock_irqsave(&gang_list_lock,flags);
+    list_for_each_entry(gnode, &gang_list, list) {
+        if (gnode->gangid == gangid)
+            goto found_gang;
+    }
+	gnode = kmalloc(sizeof(*gnode), GFP_KERNEL);
+    if (!gnode) {
+        spin_unlock_irqrestore(&gang_list_lock,flags);
+        return -ENOMEM;
+    }
+    gnode->gangid = gangid;
+    gnode->num_threads = 0;
+    INIT_LIST_HEAD(&gnode->pid_list);
+    list_add(&gnode->list, &gang_list);
+    new_gang = true;
+found_gang:
+    if (gnode->num_threads >= num_online_cpus()) {
+        ret = -EINVAL;
+        if (new_gang) {
+            list_del(&gnode->list);
+            kfree(gnode);
+        }
+        spin_unlock_irqrestore(&gang_list_lock,flags);
+        return ret;
+    }	
+	gpid = kmalloc(sizeof(*gpid), GFP_KERNEL);
+    if (!gpid) {
+        if (new_gang) {
+            list_del(&gnode->list);
+            kfree(gnode);
+        }
+        spin_unlock_irqrestore(&gang_list_lock,flags);
+        return -ENOMEM;
+    }
+    gpid->pid = pid;
+    list_add_tail(&gpid->list, &gnode->pid_list);
+    gnode->num_threads++;
+    spin_unlock_irqrestore(&gang_list_lock,flags);
+	rcu_read_lock();
+	p = find_task_by_vpid(pid);
+	if (!p) {
+        rcu_read_unlock();
+        goto cleanup_pid;
+    }
+	get_task_struct(p);
+	rcu_read_unlock();
+	gthd = kmalloc(sizeof(*gthd), GFP_KERNEL);
+	if (!gthd){
+        ret= -ENOMEM;
+		goto cleanup_task;
+	}
+	gthd->pid = pid;
+	gthd->exec_time = exec_time;
+	gthd->gangid = gangid;
+	gthd->cpu = task_cpu(p);
+    timer_setup(&gthd->timer, exec_timer_callback, 0);
+    mod_timer(&gthd->timer, jiffies + msecs_to_jiffies(exec_time*1000));
+	//ret = do_sched_setscheduler(p->pid, SCHED_GANG, &param);
+	ret = sched_setscheduler(p, SCHED_GANG, &param);
+	if(ret){
+		goto cleanup_gthd;
+	}
+	p->gang_se.gang_thd = gthd;
+    cpu = task_cpu(p);
+    per_cpu(current_gang_id, cpu) = -1;
+    del_timer(&per_cpu(gang_timer, cpu));
+	put_task_struct(p);
+    return 0;
+cleanup_gthd:
+    kfree(gthd);
+cleanup_task:
+    put_task_struct(p);
+cleanup_pid:
+    spin_lock_irqsave(&gang_list_lock,flags);
+    list_del(&gpid->list);
+    kfree(gpid);
+    gnode->num_threads--;
+    if (gnode->num_threads == 0) {
+        list_del(&gnode->list);
+        kfree(gnode);
+    }
+    spin_unlock_irqrestore(&gang_list_lock,flags);
+    return ret;
+}
+static int __exit_gang(int pid){
+    struct task_struct *p;
+	struct gang_node *gnode;
+    struct gang_pid *gpid, *tmp;
+	int found = 0;
+    unsigned long flags;
+    struct gang_thread *gthd;
+    struct sched_param param = { .sched_priority = 0 };
+	rcu_read_lock();
+	p = find_task_by_vpid(pid);
+	if (!p) {
+        rcu_read_unlock();
+        return -ESRCH;
+    }
+	get_task_struct(p);
+	rcu_read_unlock();
+	if (!p->gang_se.gang_thd) {
+        put_task_struct(p);
+        return -EINVAL;
+    }
+
+    // int cpu = task_cpu(p);//moved this logic to register_gang to avoid racing 
+    // per_cpu(current_gang_id, cpu) = -1;
+    // del_timer(&per_cpu(gang_timer, cpu));
+    gthd = p->gang_se.gang_thd;
+    del_timer_sync(&gthd->timer);
+
+	spin_lock_irqsave(&gang_list_lock,flags);
+    list_for_each_entry(gnode, &gang_list, list) {
+        if (gnode->gangid == p->gang_se.gang_thd->gangid) {
+            list_for_each_entry_safe(gpid, tmp, &gnode->pid_list, list) {
+                if (gpid->pid == pid) {
+                    list_del(&gpid->list);
+                    kfree(gpid);
+                    gnode->num_threads--;
+                    found = 1;
+                    break;
+                }
+            }
+            if (gnode->num_threads == 0) {
+                list_del(&gnode->list);
+                kfree(gnode);
+            }
+            break;
+        }
+    }
+    spin_unlock_irqrestore(&gang_list_lock,flags);
+	if (found) {
+        kfree(p->gang_se.gang_thd);
+        p->gang_se.gang_thd = NULL;
+    }
+    sched_setscheduler(p, SCHED_NORMAL, &param);
+	put_task_struct(p);
+	return found ? 0 : -ENOENT;
+}
+SYSCALL_DEFINE1(exit_gang, int, pid){
+	return __exit_gang(pid);
+}
+SYSCALL_DEFINE2(list, int, gangid, int __user*, pids){
+	struct gang_node *gnode;
+    struct gang_pid *gpid;
+    int *tmp = NULL;
+    int i=0;
+    unsigned long flags;
+    tmp = kmalloc_array(num_online_cpus(),sizeof(int),GFP_KERNEL);
+    if(!tmp) return -ENOMEM;
+    spin_lock_irqsave(&gang_list_lock,flags);
+    list_for_each_entry(gnode, &gang_list, list) {
+        if (gnode->gangid == gangid) {
+            list_for_each_entry(gpid, &gnode->pid_list, list) {
+                if (i >= num_online_cpus()) {
+		    spin_unlock_irqrestore(&gang_list_lock,flags);
+		    kfree(tmp);
+                    return -ENOSPC;
+                }
+                tmp[i++] = gpid->pid;
+            }
+            break;
+        }
+    }
+    spin_unlock_irqrestore(&gang_list_lock,flags);
+    if (i == 0){
+        kfree(tmp);
+	return -ENOENT;
+    }
+    if (copy_to_user(pids, tmp, i * sizeof(int))){
+        kfree(tmp);
+        return -EFAULT;
+    }
+    kfree(tmp);
+    return 0;
+}
