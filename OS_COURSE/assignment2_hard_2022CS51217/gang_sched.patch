diff --git a/kernel/sched/gang.c b/kernel/sched/gang.c
new file mode 100644
index 000000000..d10a61135
--- /dev/null
+++ b/kernel/sched/gang.c
@@ -0,0 +1,192 @@
+#include <linux/init.h>
+#include <linux/sched/gang.h>
+#include <linux/timer.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+#include <linux/slab.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+#include <linux/sched/cputime.h>
+#include "sched.h"
+#define GANG_QUANTA_MS 10
+static int governor_cpu = 0;
+struct gang_ipi_data {
+    int gangid;
+    int quanta;
+};
+DEFINE_PER_CPU(int, current_gang_id);
+DEFINE_PER_CPU(struct timer_list, gang_timer);
+static void gang_ipi_handler(void *info){
+    struct gang_ipi_data *data = info;
+    int cpu = smp_processor_id();
+    per_cpu(current_gang_id, cpu) = data->gangid;
+    resched_curr(cpu_rq(cpu));
+}
+static void gang_timer_fn(struct timer_list *t)
+{
+    int cpu = smp_processor_id();
+    per_cpu(current_gang_id, cpu) = -1;
+    resched_curr(cpu_rq(cpu));
+}
+static void gang_enqueue_task(struct rq *rq, struct task_struct *p, int flags) {
+    struct gang_rq *grq = &rq->gang;
+    struct sched_gang_entity *gse = &p->gang_se;
+    unsigned long irq_flags;
+    // struct gang_thread *gthd = gse->gang_thd;
+    // printk(KERN_INFO "gang_enqueue_task was invoked by %d with gang id %d on the cpu %d\n",
+    //        p->pid, gthd->gangid, rq->cpu);
+    spin_lock_irqsave(&grq->lock,irq_flags);
+    if (!gse->on_rq) {
+        gse->gang_rq = grq;
+        INIT_LIST_HEAD(&gse->run_list);
+        list_add_tail(&gse->run_list, &grq->gangs);
+        gse->on_rq = 1;
+        grq->nr_running++;
+    }
+    spin_unlock_irqrestore(&grq->lock,irq_flags);
+}
+static void gang_dequeue_task(struct rq *rq, struct task_struct *p, int flags) {
+    struct sched_gang_entity *gse = &p->gang_se;
+    struct gang_rq *grq = gse->gang_rq;
+    unsigned long irq_flags;
+    // struct gang_thread *gthd = gse->gang_thd;
+    if (!grq || !gse->on_rq)
+        return;
+    // printk(KERN_INFO "gang_dequeue_task was invoked by %d with gang id %d on the cpu %d\n",
+    //        p->pid, gthd->gangid, rq->cpu);
+    spin_lock_irqsave(&grq->lock,irq_flags);
+    if (gse->on_rq) {
+        list_del_init(&gse->run_list);
+        grq->nr_running--;
+        gse->on_rq = 0;
+    }
+    spin_unlock_irqrestore(&grq->lock,irq_flags);
+}
+static struct task_struct *gang_pick_next_task(struct rq *rq) {
+    struct gang_rq *grq = &rq->gang;
+    struct sched_gang_entity *gse;
+    struct gang_ipi_data *ipi_data;
+    static int last_gang = -1;
+    int current_gang;
+    unsigned long irq_flags;
+    if (rq->cpu == governor_cpu) {
+        struct list_head *pos, *next;
+        bool found = false;
+        // printk(KERN_INFO "gang_pick_next_task : I am governor cpu with rq->cpu as %d and the governor_cpu as %d\n",
+        //    rq->cpu, governor_cpu);
+        spin_lock_irqsave(&grq->lock,irq_flags);
+        list_for_each_safe(pos, next, &grq->gangs) {
+            gse = list_entry(pos, struct sched_gang_entity, run_list);
+            if (gse->gang_thd->gangid > last_gang) {
+                last_gang = gse->gang_thd->gangid;
+                found = true;
+                goto found;
+            }
+        }
+        if (!list_empty(&grq->gangs)) {
+            gse = list_first_entry(&grq->gangs, struct sched_gang_entity, run_list);
+            last_gang = gse->gang_thd->gangid;
+            found = true;
+        }
+found:           
+        if (found) {
+            ipi_data = kmalloc(sizeof(*ipi_data), GFP_ATOMIC);
+            if (!ipi_data) {
+                spin_unlock_irqrestore(&grq->lock,irq_flags);
+                return NULL;
+            }
+            ipi_data->gangid = last_gang;
+            ipi_data->quanta = GANG_QUANTA_MS;//actually not needed
+            per_cpu(current_gang_id, governor_cpu) = last_gang;
+            smp_call_function(gang_ipi_handler, ipi_data, 1);
+            kfree(ipi_data);
+        }
+        spin_unlock_irqrestore(&grq->lock,irq_flags);
+    }
+    current_gang = per_cpu(current_gang_id, rq->cpu);
+
+    if (current_gang == -1) return NULL;
+    // printk(KERN_INFO "gang_pick_next_task : The current gang in per cpu region is %d at the cpu %d\n",
+    //        current_gang, rq->cpu);
+    spin_lock_irqsave(&grq->lock,irq_flags);
+    list_for_each_entry(gse, &grq->gangs, run_list) {
+        if (gse->gang_thd->gangid == current_gang && gse->on_rq) {
+            spin_unlock_irqrestore(&grq->lock,irq_flags);
+            mod_timer(&per_cpu(gang_timer, rq->cpu), jiffies + msecs_to_jiffies(GANG_QUANTA_MS));
+            return container_of(gse, struct task_struct, gang_se);
+        }
+    }
+    spin_unlock_irqrestore(&grq->lock,irq_flags);
+    return NULL;
+}
+static void check_preempt_wakeup_gang(struct rq *rq, struct task_struct *p, int wake_flags)
+{
+    if (p->sched_class < rq->curr->sched_class)
+        resched_curr(rq);
+}
+static void yield_task_gang(struct rq *rq){}
+static bool yield_to_task_gang(struct rq *rq, struct task_struct *p){return false;}
+static void put_prev_task_gang(struct rq *rq, struct task_struct *prev){}
+static void set_next_task_gang(struct rq *rq, struct task_struct *p, bool first){}
+static int balance_gang(struct rq *rq, struct task_struct *prev, struct rq_flags *rf){return 0;}
+static struct task_struct *pick_task_gang(struct rq *rq){return NULL;}
+static int select_task_rq_gang(struct task_struct *p, int prev_cpu, int wake_flags){return task_cpu(p);}
+static void migrate_task_rq_gang(struct task_struct *p, int new_cpu){}
+static void rq_online_gang(struct rq *rq){}
+static void rq_offline_gang(struct rq *rq){}
+static void task_dead_gang(struct task_struct *p){}
+static void task_tick_gang(struct rq *rq, struct task_struct *curr, int queued){}
+static void task_fork_gang(struct task_struct *p){}
+static void prio_changed_gang(struct rq *rq, struct task_struct *p, int oldprio){}
+static void switched_from_gang(struct rq *rq, struct task_struct *p){}
+static void switched_to_gang(struct rq *rq, struct task_struct *p){}
+static unsigned int get_rr_interval_gang(struct rq *rq, struct task_struct *task){return 0;}
+static void update_curr_gang(struct rq *rq){}
+static void task_change_group_gang(struct task_struct *p){}
+DEFINE_SCHED_CLASS(gang) = {
+	.enqueue_task = gang_enqueue_task,
+	.dequeue_task = gang_dequeue_task,
+	.pick_next_task = gang_pick_next_task,
+    .yield_task		= yield_task_gang,
